{
  // TUTnext API Worker on Cloudflare Python Workers (behind `tutnext-gateway`, see gateway/).
  // Deploy:  uv run pywrangler deploy     (or: cf deploy)
  // Dev:     uv run pywrangler dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutnext",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Static pages (/, /policy, /user-agreement) are served from Assets;
  // html_handling maps /policy → policy.html. API routes fall through to the Worker.
  "assets": { "directory": "./src/tutnext/static", "binding": "ASSETS" },

  // Users, OAuth tokens and the Redis-compatible key/value store (tutnext.core.d1redis)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutnext",
      "database_id": "7014de82-cb2c-4c90-853d-af0087fa0e50",
      "migrations_dir": "migrations"
    }
  ],

  // No Cron Trigger here: background jobs run in the separate `tutnext-cron` Worker
  // (wrangler.cron.jsonc) so cron and API never share a Pyodide isolate.
  "triggers": { "crons": [] },

  // Workers Paid plan: 30 s CPU per invocation (Free is 10 ms, which killed cold starts
  // mid-init and left isolates broken). Crons under a 1 h interval are capped at 30 s anyway.
  "limits": { "cpu_ms": 30000 },

  // Non-secret configuration. Secrets (wrangler secret put):
  //   APNS_PRIVATE_KEY (PEM), APNS_KEY_ID, APNS_TEAM_ID, NOTIFICATION_API_URL (optional)
  "vars": {
    "LOG_LEVEL": "INFO",
    "APNS_TOPIC": "com.meikenn.tama",
    "APNS_USE_SANDBOX": "false",
    "CLIENT_ID": "87800423252-m54i673pp45dohr68d50jb2l6j2vigbf.apps.googleusercontent.com",
    "ENABLE_MONITOR_PUSH": "false",
    "ENABLE_DAILY_PUSH": "false",
    "MONITOR_INTERVAL_SECONDS": "240",
    "MONITOR_MAX_CONCURRENT": "3"
  }
}
