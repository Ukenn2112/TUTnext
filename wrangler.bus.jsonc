{
  // TUTnext bus Worker: /bus routes only (public timetable + temporary-schedule PDFs),
  // reached through tutnext-gateway's BUS service binding. No secrets needed.
  // Deploy:  uv run pywrangler deploy -c wrangler.bus.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutnext-bus",
  "main": "src/bus_worker.py",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },


  // Users, OAuth tokens and the Redis-compatible key/value store (tutnext.core.d1redis)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutnext",
      "database_id": "7014de82-cb2c-4c90-853d-af0087fa0e50",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": { "crons": [] },

  // Workers Paid plan: 30 s CPU per invocation (Free is 10 ms, which killed cold starts
  // mid-init and left isolates broken). Crons under a 1 h interval are capped at 30 s anyway.
  "limits": { "cpu_ms": 30000 },

  // Non-secret configuration. Secrets (wrangler secret put):
  //   APNS_PRIVATE_KEY (PEM), APNS_KEY_ID, APNS_TEAM_ID, NOTIFICATION_API_URL (optional)
  "vars": {
    "LOG_LEVEL": "INFO",
    "APNS_TOPIC": "com.meikenn.tama",
    "APNS_USE_SANDBOX": "false",
    "CLIENT_ID": "87800423252-m54i673pp45dohr68d50jb2l6j2vigbf.apps.googleusercontent.com",
    "ENABLE_MONITOR_PUSH": "false",
    "ENABLE_DAILY_PUSH": "false",
    "MONITOR_INTERVAL_SECONDS": "240",
    "MONITOR_MAX_CONCURRENT": "3"
  }
}
