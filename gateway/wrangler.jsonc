{
  // TUTnext edge gateway (TypeScript). Owns tama.qaq.tw, serves the static pages and
  // forwards API calls over service bindings: /bus/* → `tutnext-bus`, the rest → `tutnext`.
  // A JS Worker cold-starts in milliseconds and never hits Pyodide's isolate failures,
  // so it can retry a Python cold-start failure and turn hangs into a clean 504.
  // Deploy:  cd gateway && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutnext-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // /, /policy, /user-agreement come straight from Assets (html_handling maps
  // /policy → policy.html); everything else falls through to the Worker.
  "assets": { "directory": "../src/tutnext/static", "binding": "ASSETS" },

  // Exact per-student login counters (rate_counters, migrations/0003); per-IP flooding is
  // handled by the zone WAF rate-limiting rule on tama.qaq.tw.
  "d1_databases": [{ "binding": "DB", "database_name": "tutnext", "database_id": "7014de82-cb2c-4c90-853d-af0087fa0e50" }],

  "services": [
    { "binding": "API", "service": "tutnext" },
    { "binding": "BUS", "service": "tutnext-bus" }
  ]
}
