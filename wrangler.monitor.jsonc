{
  // TUTnext monitor Worker: consumes the `tutnext-monitor` queue that tutnext-cron fills
  // (assignment monitor every 5 min, next-day push at 20:30 JST). See monitor_queue.py.
  // Deploy:  uv run pywrangler deploy -c wrangler.monitor.jsonc
  // Secrets: APNS_PRIVATE_KEY, APNS_KEY_ID, APNS_TEAM_ID, NOTIFICATION_API_URL (same as `tutnext`)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutnext-monitor",
  "main": "src/monitor_worker.py",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },


  // Users, OAuth tokens and the Redis-compatible key/value store (tutnext.core.d1redis)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutnext",
      "database_id": "7014de82-cb2c-4c90-853d-af0087fa0e50",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": { "crons": [] },

  // Layer 1 (concurrent T-NEXT logins) = max_batch_size × max_concurrency = 6.
  // Messages are acked when the handler returns (it never raises); max_retries only
  // covers invocations killed by the runtime.
  "queues": {
    "producers": [{ "binding": "MONITOR_QUEUE", "queue": "tutnext-monitor" }],
    "consumers": [
      { "queue": "tutnext-monitor", "max_batch_size": 3, "max_batch_timeout": 2, "max_retries": 1, "max_concurrency": 2 }
    ]
  },

  // Workers Paid plan: 30 s CPU per invocation (Free is 10 ms, which killed cold starts
  // mid-init and left isolates broken). Crons under a 1 h interval are capped at 30 s anyway.
  "limits": { "cpu_ms": 30000 },

  // Non-secret configuration. Secrets (wrangler secret put):
  //   APNS_PRIVATE_KEY (PEM), APNS_KEY_ID, APNS_TEAM_ID, NOTIFICATION_API_URL (optional)
  "vars": {
    "LOG_LEVEL": "INFO",
    "APNS_TOPIC": "com.meikenn.tama",
    "APNS_USE_SANDBOX": "false",
    "CLIENT_ID": "87800423252-m54i673pp45dohr68d50jb2l6j2vigbf.apps.googleusercontent.com",
    "ENABLE_MONITOR_PUSH": "false",
    "ENABLE_DAILY_PUSH": "false",
    "MONITOR_INTERVAL_SECONDS": "240",
    "MONITOR_MAX_CONCURRENT": "3"
  }
}
