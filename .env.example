# 数据库配置 (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# Redis 配置
REDIS_URL=redis://localhost:6379

# Apple Push Notification Service (APNs) 配置
APNS_KEY_FILE=AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.yourapp.name
APNS_USE_SANDBOX=true

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./next.log

# Google OAuth Configuration
CLIENT_ID=xxxxxxxxxxx.apps.googleusercontent.com

# 代理服务器配置
HTTP_PROXY=""

# 通知API URL
NOTIFICATION_API_URL="https://aaa.com/{title}/{message}"

# 功能开关（true=开启，false=关闭，默认均为开启）
ENABLE_MONITOR_PUSH=true
ENABLE_DAILY_PUSH=true

# ESXi 代理自愈看门狗（可选；凭据留空则禁用）
# 填写后当 HTTP_PROXY 连续失败时自动硬重启指定 VM，重启通知走 NOTIFICATION_API_URL
ESXI_HOST=
ESXI_USERNAME=
ESXI_PASSWORD=
ESXI_VM_NAME=
ESXI_VERIFY_SSL=false

# 看门狗调参
WATCHDOG_WINDOW_SECONDS=180
WATCHDOG_FAILURE_THRESHOLD=5
WATCHDOG_COOLDOWN_SECONDS=900